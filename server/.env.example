PORT=5000
NODE_ENV=development

# Supabase — Settings > API in your Supabase project dashboard
SUPABASE_URL=https://xxx.supabase.co
# "Secret key" in the Supabase dashboard (under API Keys section)
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Model (swap URL when real model is ready)
AI_MODEL_API_URL=http://localhost:8000/predict

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
