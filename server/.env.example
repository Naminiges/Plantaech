PORT=5000
NODE_ENV=development

# Supabase — Settings > API in your Supabase project dashboard
SUPABASE_URL=https://xxx.supabase.co
# "Secret key" in the Supabase dashboard (under API Keys section)
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
SUPABASE_PUBLIC_BUCKET=public-images
SUPABASE_DIAGNOSIS_BUCKET=diagnosis-images

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Model Predict API URL
AI_MODEL_API_URL=https://your-ai-model-url.up.railway.app/predict
# Or a local fallback:
AI_MODEL_API_URL=http://localhost:8000/predict

# File Upload
MAX_FILE_SIZE=10485760
# Gmail SMTP (Email)
SMTP_USER=youremail.com
SMTP_PASS=16-character App Password #(without spaces)